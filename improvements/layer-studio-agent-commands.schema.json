{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer-studio/agent-commands/v2",
  "title": "Layer Studio agent command batch",
  "description": "Contract between an agent and the editor. The agent proposes a CommandBatch against a scene snapshot; the editor validates it (schema + guardrails), applies it to a sandbox copy, renders, and returns a BatchResult. Nothing touches the live scene until the user approves. Percent values are relative to the format canvas (x/w to width, y/h to height). Font sizePct is relative to canvas HEIGHT. v2 extends v1, whose only command was set-variable.",
  "type": "object",
  "required": ["schema", "sceneId", "baseRevision", "commands"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "layer-studio/agent-commands/v2" },
    "sceneId": { "type": "string" },
    "baseRevision": { "type": "integer", "minimum": 0, "description": "Scene revision the agent read. Editor rejects with STALE_REVISION if the scene moved on." },
    "formatId": { "type": "string", "default": "master", "description": "Format the geometry/style commands target. Non-master formats store changes as formats[].layerOverrides." },
    "label": { "type": "string", "maxLength": 80, "description": "Human name for the proposal, e.g. 'B · Ink night'." },
    "rationale": { "type": "string", "maxLength": 600 },
    "atomic": { "type": "boolean", "default": true, "description": "If true, any failing command rejects the whole batch." },
    "commands": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": { "$ref": "#/$defs/Command" }
    }
  },

  "$defs": {
    "Percent": { "type": "number", "minimum": -100, "maximum": 200 },
    "Hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "Color": { "description": "Hex, rgba(), or a brand palette name (resolved by the editor).", "type": "string", "maxLength": 64 },
    "LayerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-_]{0,63}$" },

    "Command": {
      "oneOf": [
        { "$ref": "#/$defs/SetVariable" },
        { "$ref": "#/$defs/SetLayer" },
        { "$ref": "#/$defs/AddLayer" },
        { "$ref": "#/$defs/RemoveLayer" },
        { "$ref": "#/$defs/DuplicateLayer" },
        { "$ref": "#/$defs/ReorderLayer" },
        { "$ref": "#/$defs/SwapAsset" },
        { "$ref": "#/$defs/SetAnimation" },
        { "$ref": "#/$defs/SetKeyframes" },
        { "$ref": "#/$defs/ClearAnimation" },
        { "$ref": "#/$defs/SetFormat" },
        { "$ref": "#/$defs/SetSceneDuration" }
      ],
      "discriminator": { "propertyName": "type" }
    },

    "SetVariable": {
      "description": "Existing v1 command. Changes a bound variable's value (copy).",
      "type": "object", "required": ["type", "variableId", "value"], "additionalProperties": false,
      "properties": {
        "type": { "const": "set-variable" },
        "variableId": { "type": "string" },
        "value": { "type": "string" },
        "locale": { "type": "string", "description": "Optional; defaults to the scene's active locale." }
      }
    },

    "LayerPatch": {
      "description": "Any subset of editable layer fields. Unknown keys are rejected. Fields not valid for the layer type (e.g. font on an image) return FIELD_NOT_APPLICABLE.",
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "x": { "$ref": "#/$defs/Percent" },
        "y": { "$ref": "#/$defs/Percent" },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
        "z": { "type": "integer", "minimum": 0, "maximum": 999 },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "visible": { "type": "boolean" },
        "fit": { "enum": ["cover", "contain", "fill"] },
        "recolorEnabled": { "type": "boolean" },
        "recolorColor": { "$ref": "#/$defs/Color" },
        "outlineEnabled": { "type": "boolean" },
        "outlineColor": { "$ref": "#/$defs/Color" },
        "outlineWidth": { "type": "number", "minimum": 0, "maximum": 40 },
        "text": { "type": "string", "description": "Literal text. Rejected with BOUND_TEXT if the layer has bindings.text; use set-variable instead." },
        "color": { "$ref": "#/$defs/Color" },
        "align": { "enum": ["left", "center", "right"] },
        "verticalAlign": { "enum": ["top", "middle", "bottom"] },
        "overflow": { "enum": ["clip", "visible"] },
        "font": { "$ref": "#/$defs/FontPatch" }
      }
    },

    "FontPatch": {
      "description": "Merged into the layer's font object.",
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "family": { "type": "string", "description": "Must exist in brandKit.fonts (guardrail BRAND_FONT)." },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "style": { "enum": ["normal", "italic"] },
        "sizePct": { "type": "number", "minimum": 0.4, "maximum": 20, "description": "Percent of canvas height." },
        "lineHeight": { "type": "number", "minimum": 0.8, "maximum": 2.5 },
        "letterSpacingEm": { "type": "number", "minimum": -0.1, "maximum": 1 },
        "transform": { "enum": ["none", "uppercase", "lowercase", "capitalize"] }
      }
    },

    "SetLayer": {
      "type": "object", "required": ["type", "layerId", "patch"], "additionalProperties": false,
      "properties": {
        "type": { "const": "set-layer" },
        "layerId": { "$ref": "#/$defs/LayerId" },
        "patch": { "$ref": "#/$defs/LayerPatch" }
      }
    },

    "NewLayer": {
      "type": "object", "required": ["id", "type"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/LayerId" },
        "type": { "enum": ["shape", "gradient", "image", "text"] },
        "role": { "enum": ["background", "foreground"], "default": "foreground" },
        "box": {
          "type": "object", "required": ["x", "y", "w", "h"], "additionalProperties": false,
          "properties": {
            "x": { "$ref": "#/$defs/Percent" }, "y": { "$ref": "#/$defs/Percent" },
            "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "z": { "type": "integer", "minimum": 0, "maximum": 999 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "shape": { "enum": ["rect", "ellipse", "line"], "description": "type=shape only." },
        "fill": { "$ref": "#/$defs/Color", "description": "type=shape only." },
        "gradient": {
          "description": "type=gradient only.",
          "type": "object", "required": ["angleDeg", "stops"], "additionalProperties": false,
          "properties": {
            "angleDeg": { "type": "number", "minimum": 0, "maximum": 360 },
            "stops": {
              "type": "array", "minItems": 2, "maxItems": 6,
              "items": {
                "type": "object", "required": ["at", "color"], "additionalProperties": false,
                "properties": { "at": { "type": "number", "minimum": 0, "maximum": 1 }, "color": { "$ref": "#/$defs/Color" } }
              }
            }
          }
        },
        "assetRef": { "$ref": "#/$defs/AssetRef", "description": "type=image only." },
        "text": { "type": "string", "description": "type=text only." },
        "font": { "$ref": "#/$defs/FontPatch" },
        "color": { "$ref": "#/$defs/Color" },
        "align": { "enum": ["left", "center", "right"] },
        "verticalAlign": { "enum": ["top", "middle", "bottom"] },
        "bindText": { "type": "string", "description": "Optional variableId to bind text to. Must exist." }
      }
    },

    "AddLayer": {
      "type": "object", "required": ["type", "layer"], "additionalProperties": false,
      "properties": {
        "type": { "const": "add-layer" },
        "layer": { "$ref": "#/$defs/NewLayer" },
        "above": { "$ref": "#/$defs/LayerId", "description": "Optional: place directly above this layer (overrides z)." }
      }
    },

    "RemoveLayer": {
      "description": "Rejected for locked layers and for layers listed in protectedLayerIds.",
      "type": "object", "required": ["type", "layerId"], "additionalProperties": false,
      "properties": { "type": { "const": "remove-layer" }, "layerId": { "$ref": "#/$defs/LayerId" } }
    },

    "DuplicateLayer": {
      "type": "object", "required": ["type", "layerId", "newId"], "additionalProperties": false,
      "properties": {
        "type": { "const": "duplicate-layer" },
        "layerId": { "$ref": "#/$defs/LayerId" },
        "newId": { "$ref": "#/$defs/LayerId" },
        "patch": { "$ref": "#/$defs/LayerPatch" }
      }
    },

    "ReorderLayer": {
      "type": "object", "required": ["type", "layerId"], "additionalProperties": false,
      "properties": {
        "type": { "const": "reorder-layer" },
        "layerId": { "$ref": "#/$defs/LayerId" },
        "z": { "type": "integer", "minimum": 0, "maximum": 999 },
        "above": { "$ref": "#/$defs/LayerId" },
        "below": { "$ref": "#/$defs/LayerId" }
      },
      "oneOf": [{ "required": ["z"] }, { "required": ["above"] }, { "required": ["below"] }]
    },

    "AssetRef": {
      "description": "Reference into the asset catalogue returned by the editor in the snapshot. The agent never writes raw URLs.",
      "type": "object", "required": ["catalog", "name"], "additionalProperties": false,
      "properties": {
        "catalog": { "enum": ["logos", "photography", "uploads"] },
        "name": { "type": "string", "description": "Catalogue entry name, e.g. 'physician wordmark ink'." },
        "variant": { "enum": ["svg", "png", "jpg"], "description": "Preferred file variant; svg preferred for logos." }
      }
    },

    "SwapAsset": {
      "description": "Replace an image layer's source. Layer geometry is preserved; for logos fit is forced to 'contain' and aspect ratio is never altered.",
      "type": "object", "required": ["type", "layerId", "asset"], "additionalProperties": false,
      "properties": {
        "type": { "const": "swap-asset" },
        "layerId": { "$ref": "#/$defs/LayerId" },
        "asset": { "$ref": "#/$defs/AssetRef" },
        "focus": {
          "description": "Optional focal point for cover-fit crops, 0-100 each.",
          "type": "object", "additionalProperties": false,
          "properties": { "x": { "type": "number", "minimum": 0, "maximum": 100 }, "y": { "type": "number", "minimum": 0, "maximum": 100 } }
        }
      }
    },

    "Preset": {
      "enum": ["breathe","idle","sway","walk","float","flicker","drift","pulse","fadeIn","parallax","fadeOut","zoom","spin","shake","hop","swing","orbit","nod","blinkIn","none"]
    },

    "SetAnimation": {
      "description": "Apply a named preset to a layer. Replaces any existing preset on that layer; custom keyframes (set-keyframes) are cleared.",
      "type": "object", "required": ["type", "layerId", "preset"], "additionalProperties": false,
      "properties": {
        "type": { "const": "set-animation" },
        "layerId": { "$ref": "#/$defs/LayerId" },
        "preset": { "$ref": "#/$defs/Preset" },
        "startMs": { "type": "integer", "minimum": 0, "default": 0 },
        "durationMs": { "type": "integer", "minimum": 100, "description": "Defaults to the preset's native duration; capped to scene.duration - startMs." },
        "easing": { "enum": ["linear", "ease-in", "ease-out", "ease-in-out"], "default": "ease-out" },
        "loop": { "type": "boolean", "description": "Defaults per preset (pulse/float/breathe loop; fadeIn/zoom do not)." },
        "intensity": { "type": "number", "minimum": 0, "maximum": 2, "default": 1 }
      }
    },

    "SetKeyframes": {
      "description": "Custom timing. NOTE: the keyframe schema is not documented in the current scene file (all keyframes arrays are empty). The shape below is the proposed v2 definition and must be confirmed against the renderer before implementation.",
      "type": "object", "required": ["type", "layerId", "keyframes"], "additionalProperties": false,
      "properties": {
        "type": { "const": "set-keyframes" },
        "layerId": { "$ref": "#/$defs/LayerId" },
        "keyframes": {
          "type": "array", "minItems": 2, "maxItems": 40,
          "items": {
            "type": "object", "required": ["t", "values"], "additionalProperties": false,
            "properties": {
              "t": { "type": "integer", "minimum": 0, "description": "Milliseconds from scene start." },
              "easing": { "enum": ["linear", "ease-in", "ease-out", "ease-in-out", "step"] },
              "values": {
                "type": "object", "additionalProperties": false, "minProperties": 1,
                "properties": {
                  "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" },
                  "rotation": { "type": "number" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "scale": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          }
        }
      }
    },

    "ClearAnimation": {
      "type": "object", "required": ["type", "layerId"], "additionalProperties": false,
      "properties": { "type": { "const": "clear-animation" }, "layerId": { "$ref": "#/$defs/LayerId" } }
    },

    "SetFormat": {
      "description": "Create or modify a format (story, A5, square...). New formats inherit master; layerOverrides hold per-format geometry/style patches.",
      "type": "object", "required": ["type", "formatId"], "additionalProperties": false,
      "properties": {
        "type": { "const": "set-format" },
        "formatId": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "label": { "type": "string" },
        "channel": { "enum": ["print", "social", "web", "display", "video"] },
        "width": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "layerOverrides": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/LayerPatch" },
          "description": "Keyed by layerId."
        },
        "pinnedLayerIds": { "type": "array", "items": { "$ref": "#/$defs/LayerId" } },
        "safeZone": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "top": { "type": "number", "minimum": 0, "maximum": 0.4 }, "right": { "type": "number", "minimum": 0, "maximum": 0.4 },
            "bottom": { "type": "number", "minimum": 0, "maximum": 0.4 }, "left": { "type": "number", "minimum": 0, "maximum": 0.4 }
          }
        }
      }
    },

    "SetSceneDuration": {
      "type": "object", "required": ["type", "durationMs"], "additionalProperties": false,
      "properties": { "type": { "const": "set-scene-duration" }, "durationMs": { "type": "integer", "minimum": 1000, "maximum": 120000 } }
    },

    "Snapshot": {
      "description": "What the editor sends the agent before it plans (the 'perception' half of the contract).",
      "type": "object", "required": ["revision", "scene", "render", "assets", "brandKit", "guardrails"],
      "properties": {
        "revision": { "type": "integer" },
        "scene": { "description": "Full scene JSON (e.g. The-Physician-Flyer.json)." },
        "render": {
          "type": "object", "required": ["formatId", "pngBase64"],
          "properties": {
            "formatId": { "type": "string" }, "pngBase64": { "type": "string" },
            "layerBounds": {
              "description": "Measured rendered rectangles incl. text overflow, so the agent need not guess.",
              "type": "array",
              "items": {
                "type": "object", "required": ["layerId", "rect", "clipped"],
                "properties": {
                  "layerId": { "type": "string" },
                  "rect": { "type": "object", "properties": { "x": {"type":"number"}, "y": {"type":"number"}, "w": {"type":"number"}, "h": {"type":"number"} } },
                  "textLines": { "type": "integer" }, "clipped": { "type": "boolean" },
                  "contrastRatio": { "type": ["number", "null"], "description": "WCAG ratio against the pixels behind the layer." }
                }
              }
            }
          }
        },
        "assets": {
          "type": "object",
          "properties": {
            "logos": { "type": "array", "items": { "type": "object", "properties": { "name": {"type":"string"}, "variants": {"type":"array","items":{"type":"string"}}, "tone": { "enum": ["light", "dark", "colour"] } } } },
            "photography": { "type": "array", "items": { "type": "object", "properties": { "name": {"type":"string"}, "width": {"type":"integer"}, "height": {"type":"integer"}, "tags": {"type":"array","items":{"type":"string"}} } } }
          }
        },
        "brandKit": { "description": "Palette, fonts, logo list." },
        "guardrails": { "$ref": "#/$defs/GuardrailConfig" },
        "sourceFacts": {
          "type": "object", "description": "Verified facts the agent may use verbatim. Anything not here may not be invented.",
          "properties": { "address": {"type":"string"}, "url": {"type":"string"}, "phone": {"type":"string"}, "hours": {"type":"string"}, "offers": {"type":"array","items":{"type":"string"}}, "prices": {"type":"array","items":{"type":"string"}} }
        }
      }
    },

    "GuardrailConfig": {
      "description": "Enforced server-side by the editor on every batch. 'block' = reject; 'warn' = apply but flag.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "block": { "type": "boolean", "description": "true: violations reject the batch. false: violations are returned as warnings." },
        "rules": {
          "type": "object",
          "properties": {
            "SAFE_ZONE": { "description": "Foreground text and logos must sit inside the format safe zone (default 8% margin).", "enum": ["off", "warn", "block"], "default": "block" },
            "TEXT_OVERFLOW": { "description": "No text layer may clip or exceed its box (measured on render).", "enum": ["off", "warn", "block"], "default": "block" },
            "BRAND_COLOR": { "description": "Colors must come from brandKit.palette (or tints with opacity).", "enum": ["off", "warn", "block"], "default": "warn" },
            "BRAND_FONT": { "description": "Font families must exist in brandKit.fonts.", "enum": ["off", "warn", "block"], "default": "block" },
            "CONTRAST": { "description": "Text vs. rendered background >= minContrast (WCAG).", "enum": ["off", "warn", "block"], "default": "warn" },
            "MIN_TEXT_SIZE": { "description": "Smallest allowed font sizePct.", "enum": ["off", "warn", "block"], "default": "warn" },
            "LOGO_INTEGRITY": { "description": "Logo aspect ratio preserved; no recolor outside brand logo variants; min clear space.", "enum": ["off", "warn", "block"], "default": "block" },
            "LOCKED_LAYER": { "description": "Locked layers cannot be changed.", "enum": ["off", "block"], "default": "block" },
            "NO_INVENTED_FACTS": { "description": "Text must not add addresses, URLs, prices, offers or hours absent from sourceFacts (checked by pattern + LLM review).", "enum": ["off", "warn", "block"], "default": "block" }
          }
        },
        "minContrast": { "type": "number", "default": 4.5 },
        "minTextSizePct": { "type": "number", "default": 0.9 },
        "protectedLayerIds": { "type": "array", "items": { "$ref": "#/$defs/LayerId" } }
      }
    },

    "BatchResult": {
      "description": "Returned by the editor for every submitted batch (and for dry runs).",
      "type": "object", "required": ["status", "sceneRevision"],
      "properties": {
        "status": { "enum": ["applied-to-sandbox", "rejected", "applied-live"] },
        "sceneRevision": { "type": "integer" },
        "sandboxId": { "type": "string" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/Issue" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/Issue" } },
        "render": { "type": "object", "properties": { "pngBase64": {"type":"string"}, "layerBounds": {"type":"array"} } }
      }
    },

    "Issue": {
      "type": "object", "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": ["SCHEMA", "STALE_REVISION", "UNKNOWN_LAYER", "UNKNOWN_VARIABLE", "UNKNOWN_ASSET", "DUPLICATE_ID",
                   "FIELD_NOT_APPLICABLE", "BOUND_TEXT", "SAFE_ZONE", "TEXT_OVERFLOW", "BRAND_COLOR", "BRAND_FONT",
                   "CONTRAST", "MIN_TEXT_SIZE", "LOGO_INTEGRITY", "LOCKED_LAYER", "PROTECTED_LAYER", "NO_INVENTED_FACTS",
                   "TIMELINE_RANGE", "LIMIT_EXCEEDED"]
        },
        "commandIndex": { "type": "integer" },
        "layerId": { "type": "string" },
        "message": { "type": "string" },
        "suggestion": { "type": "string", "description": "Machine-readable hint the agent can act on, e.g. 'h>=17.4' for text overflow." }
      }
    }
  },

  "x-workflow": [
    "1. Editor sends Snapshot (scene JSON, render PNG, layerBounds, asset catalogue, brandKit, guardrails, sourceFacts).",
    "2. Agent plans N distinct concepts (different intent, not rewordings) and returns N CommandBatch objects.",
    "3. Editor validates each (schema, then guardrails), applies to its own sandbox copy and renders. Never to the live scene.",
    "4. Editor returns BatchResult per concept. Agent may revise (max 3 rounds) using Issue.suggestion.",
    "5. UI shows N thumbnails with Apply / Discard. Apply promotes the sandbox to the live scene as one undo step.",
    "6. Every applied batch is stored with its label, rationale and revision for audit and undo."
  ],
  "x-implementation-notes": [
    "Reuse one patch applier for set-layer, set-format.layerOverrides and duplicate-layer.patch.",
    "Validate commands against the schema first, then run guardrails on the post-apply sandbox render, since TEXT_OVERFLOW, CONTRAST and SAFE_ZONE need measured results.",
    "Open items before build: (a) document the keyframe schema, (b) expose photography in the asset catalogue (only logos are in brandKit today), (c) define revision numbering, (d) decide whether palette names are accepted in Color.",
    "Command order matters. Commands run sequentially; later commands see earlier results, e.g. add-layer then set-animation on it."
  ]
}
