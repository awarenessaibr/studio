  "agent": {
    "endpoint": "/api/agent-first/chat",
    "mode": "studio-builder",
    "aliasEndpoint": "/api/studio-builder/agent",
    "description": "Free-form requests go to the same provider proxy as Agent First Studio. The server owns the prompt, keys and action validation; the page keeps its local rule engine as the primary path."
  },
  "addOns": [
    {
      "id": "live-preview",
      "name": "Live module preview",
      "status": "implemented",
      "description": "The stage embeds the real studio surface selected by the renderer (Layer Studio, Asset Studio Agent in clean-canvas mode, or Agent First Canvas). It loads studio-core.js, brand-pack.js and the surface’s own scripts, then reports which globals actually loaded.",
      "usage": "Turn on Live preview, or use the expand button to inspect the real page full-screen."
    },
    {
      "id": "server-catalog",
      "name": "Server-owned capability catalog",
      "status": "implemented",
      "description": "The 28 capabilities, presets, rules, surfaces and add-on notes come from /api/studio-builder/catalog. The endpoint adds live counts for brand packs, fonts, animations, assets and segments. The browser caches the last good catalog for offline use.",
      "usage": "The status pill in the top bar shows whether the current catalog came from the server or the cache. Press Sync to refresh."
    },
    {
      "id": "agent-proxy",
      "name": "Free-form agent fallback",
      "status": "implemented",
      "description": "Unknown requests are sent through /api/agent-first/chat with mode=studio-builder. The server supplies a builder-specific system prompt, validates every module id and region, and returns actions the page can apply. Local module/region commands never leave the browser.",
      "usage": "Ask for something the local rules cannot parse, for example “make this feel like a publishing desk”. Configure DeepSeek or Ollama on the server to use it."
    },
    {
      "id": "resizable",
      "name": "Resizable screen regions",
      "status": "implemented",
      "description": "Drag the separators around the stage to resize the left, right, top and bottom regions. Sizes are remembered in the browser and included in the downloaded layout.",
      "usage": "Drag a separator, or focus it and use the arrow keys. Press Reset panels to restore the defaults."
    },
    {
      "id": "layout-import",
      "name": "Layout import",
      "status": "implemented",
      "description": "A saved layout JSON can be loaded back from the Brief tab, so a build brief and the layout it came from stay together.",
      "usage": "Brief → Import layout JSON."
    },
    {
      "id": "deploy",
      "name": "Deploy as a running page",
      "status": "implemented",
      "description": "Deploy writes a real page under data/studio-builder/pages and serves it at /built/<id>. The composed regions are server-rendered, the stage runs the selected real surface, module tiles hydrate live counts from the catalog API, and /built/<id>/surface opens the full original surface.",
      "usage": "Open the Deploy tab, name the page, choose a base page and press Deploy page."
    },
    {
      "id": "stage-picking",
      "name": "Stage picking + project plan",
      "status": "implemented",
      "description": "Inspect mode turns the live stage into a picker. Click an element or drag a region, choose the capability it represents, and add it to a cross-page project plan with the page, selector, element text and rectangle. The plan is saved in the browser, can be applied to the layout, downloaded/imported, and is included when the page is deployed.",
      "usage": "Choose a start page, press Inspect above the stage, click or drag, then add the picked block to the plan from the Plan tab."
    }
  ],
  "limitations": [
    "The live preview embeds a complete real surface. It does not yet mount individual capabilities into arbitrary regions; that needs a per-module mount contract on each studio page.",
    "The capability catalog is a maintained JSON mirror of the capability map. Update src/shared/studio-builder-catalog.json when the docs add or remove a module.",
    "The model fallback needs server-side credentials or a running local model. The browser never receives an API key.",
    "Deployments are local to data/studio-builder/pages; they are files on this server, not a remote hosting integration."
  ],
