{
  "name": "studio-layers",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-build 2D layered-image animation studio, brand-template and final-asset tooling. No dependencies: these scripts are shortcuts only.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:smoke": "node tests/smoke.js",
    "test:asset-studio": "node tests/asset-studio.js",
    "test:agent-studio": "node tests/agent-studio.js",
    "test:menus": "node tests/menus.js",
    "test:visual": "node tests/visual.js",
    "test:visual:report": "node tests/visual.js --report",
    "test:all": "npm test && npm run test:smoke && npm run test:asset-studio && npm run test:visual",
    "crawl": ".venv/bin/python scripts/crawler-combined.py",
    "publish:templates": "node scripts/publish-brand-templates.js",
    "test:crawler": "node --test tests/crawler.test.js"
  }
}
