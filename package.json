{
  "name": "studio-layers",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-build 2D layered-image animation studio, brand-template and final-asset tooling. No dependencies: these scripts are shortcuts only.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:smoke": "node tests/smoke.js",
    "test:studio-builder": "node tests/studio-builder.js",
    "test:asset-studio": "node tests/asset-studio.js",
    "test:agent-studio": "node tests/agent-studio.js",
    "test:studio-timeline": "node tests/studio-timeline.js",
    "test:scene-library": "node --test tests/scene-library.test.js",
    "test:scene-studio": "node tests/scene-studio.js",
    "test:project-canvas": "node --test tests/project-canvas.test.js",
    "test:animation-roundtrip": "node tests/animation-roundtrip.js",
    "test:text-overflow": "node tests/text-overflow.js",
    "test:menus": "node tests/menus.js",
    "test:fill": "node tests/fill-holes.js",
    "test:visual": "node tests/visual.js",
    "test:visual:report": "node tests/visual.js --report",
    "test:all": "npm test && npm run test:smoke && npm run test:studio-builder && npm run test:studio-timeline && npm run test:scene-library && npm run test:scene-studio && npm run test:project-canvas && npm run test:segmentation-wire && npm run test:borders-segmentation && npm run test:segmentation-autowire && npm run test:segmented-composition && npm run test:asset-studio && npm run test:animation-roundtrip && npm run test:text-overflow && npm run test:fill && npm run test:visual",
    "crawl": ".venv/bin/python scripts/crawler-combined.py",
    "publish:templates": "node scripts/publish-brand-templates.js",
    "test:crawler": "node --test tests/crawler.test.js",
    "check:agent-pack": "node scripts/check-agent-pack.js",
    "build:agent-library": "node tools/build-agent-library.js",
    "build:segments": ".venv/bin/python scripts/build-segment-library.py",
    "build:scene-library": ".venv/bin/python scripts/build-scene-library.py",
    "wire:segments": "node scripts/wire-segmented-layers.js",
    "wire:segmentation": "node scripts/wire-segmentation-project.js",
    "wire:borders-segmentation": "node scripts/wire-borders-web-segmentation.js",
    "restore:segments": "node scripts/wire-segmented-layers.js --restore",
    "test:segmentation-wire": "node --test tests/segmented-composition.test.js",
    "test:borders-segmentation": "node --test tests/segmentation-borders.test.js",
    "test:segmentation-autowire": "node --test tests/segmentation-autowire.test.js",
    "test:segmented-composition": "node tests/segmented-composition.js",
    "test:segments": "node --test tests/segment-library.test.js"
  }
}
